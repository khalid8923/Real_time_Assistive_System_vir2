# ============================================================
#  CaptionBridge — Environment Variables
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit `.env.local` to git.
# ============================================================

# ================ Better Auth (required) ================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================ Admin Panel (required) ================
ADMIN_PASSWORD=ChangeMe123!

# ================ Database — Turso (required) ================
# Get from: https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# ================ Speech-to-Text (at least one required) ================
# Hakim AI (primary — Arabic-first, supports 3 keys for rotation)
HAKIM_API_KEY=your-hakim-api-key-here
HAKIM_API_KEY_2=your-second-hakim-key-here
HAKIM_API_KEY_3=

# Groq Whisper (fallback STT + LLM fallback)
GROQ_API_KEY=your-groq-api-key-here

# ================ LLM (at least one required) ================
# NVIDIA NIM (primary — supports 3 keys for rotation)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# Google Gemini (last resort)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=

# ================ Email (optional — for signup verification) ================
# Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Resend (alternative)
RESEND_API_KEY=
EMAIL_FROM=CaptionBridge <onboarding@resend.dev>

# ================ Telegram Notifications (optional) ================
# For the "I want to ask" feature — notifies the professor
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================ Google OAuth (optional — hidden in UI) ================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=